{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/harshsinha-12/assignment-cozmo/docs/schemas/floorplan.schema.json",
  "title": "Cozmo FloorPlan IR",
  "description": "Tier-agnostic dimensioned floor plan. Units in the public document are centimetres unless units is relative.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "units",
    "status",
    "rooms",
    "walls",
    "openings",
    "provenance"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "0.1.0"
    },
    "units": {
      "type": "string",
      "enum": ["cm", "relative"],
      "description": "cm means metric. relative means SfM-up-to-scale; lengths are not centimetres."
    },
    "status": {
      "type": "string",
      "enum": ["ok", "partial", "failed"]
    },
    "warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/warning" }
    },
    "floor_id": { "type": "string" },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame"],
      "properties": {
        "frame": {
          "type": "string",
          "description": "e.g. job-floor-plane, gravity-xy"
        },
        "up": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "rooms": {
      "type": "array",
      "items": { "$ref": "#/$defs/room" }
    },
    "walls": {
      "type": "array",
      "items": { "$ref": "#/$defs/wall" }
    },
    "openings": {
      "type": "array",
      "items": { "$ref": "#/$defs/opening" }
    },
    "stitch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "edges": {
          "type": "array",
          "items": { "$ref": "#/$defs/stitch_edge" }
        }
      }
    },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "point2": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2,
      "description": "x, y in document units"
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "missing_scale",
            "insufficient_overlap",
            "non_manhattan",
            "disconnected_rooms",
            "low_confidence",
            "unsupported_tier",
            "incomplete_scan",
            "other"
          ]
        },
        "message": { "type": "string" },
        "refs": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "room": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "polygon"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "polygon": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/point2" }
        },
        "ceiling_height": { "type": "number" },
        "area": { "type": "number", "description": "square document units" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "wall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "a", "b", "length"],
      "properties": {
        "id": { "type": "string" },
        "room_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "a": { "$ref": "#/$defs/point2" },
        "b": { "$ref": "#/$defs/point2" },
        "length": {
          "type": "number",
          "description": "document units (cm if units=cm)"
        },
        "thickness": { "type": "number" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "error_interval": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2,
          "description": "optional [low, high] length interval"
        }
      }
    },
    "opening": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "wall_id", "width"],
      "properties": {
        "id": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": ["door", "window", "cased_opening", "unknown"]
        },
        "wall_id": { "type": "string" },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "offset_along_wall": {
          "type": "number",
          "description": "distance from wall.a to opening center"
        },
        "connects_room_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "stitch_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left_room", "right_room", "via"],
      "properties": {
        "left_room": { "type": "string" },
        "right_room": { "type": "string" },
        "via": { "type": "string", "description": "opening id" },
        "dx": { "type": "number" },
        "dy": { "type": "number" },
        "dtheta_deg": { "type": "number" },
        "residual": { "type": "number" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "scale_source", "pipeline"],
      "properties": {
        "tier": {
          "type": "string",
          "enum": ["photos", "video", "lidar", "synthetic", "mixed"]
        },
        "scale_source": {
          "type": "string",
          "enum": [
            "lidar",
            "arkit_poses",
            "arcore_poses",
            "imu_vo",
            "known_length",
            "assumed_door",
            "none",
            "synthetic"
          ]
        },
        "gravity_source": {
          "type": "string",
          "enum": ["device", "plane_fit", "assumed", "synthetic", "unknown"]
        },
        "pipeline": { "type": "string" },
        "inputs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": { "type": "string" }
      }
    }
  }
}
